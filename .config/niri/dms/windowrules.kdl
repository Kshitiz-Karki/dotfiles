// @id=wr_1786723101097323582 @name=foot
window-rule {
    match app-id="^foot$"
    open-maximized-to-edges true
    open-on-workspace "1"
}

// @id=wr_1786723219927804439 @name=brave-origin
window-rule {
    match app-id="^brave-origin$"
    open-maximized-to-edges true
}

// @id=wr_1786723326490172261 @name=anki
window-rule {
    match app-id="^anki$"
    open-maximized-to-edges true
}

// @id=wr_1786723486281606460 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    open-maximized true
}
